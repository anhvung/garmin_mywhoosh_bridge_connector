# intervals.icu credentials (Settings -> Developer Settings -> API key)
ICU_API_KEY=your_intervals_icu_api_key
# Athlete id; 0 = the athlete the API key belongs to
ICU_ATHLETE_ID=0

# Garmin Connect credentials (email + password; tokens are cached in garmin_tokens.json)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your_garmin_password

# Where to keep local state (processed activity ids, garmin token store)
BRIDGE_DATA_DIR=.data

# How many days back to look for new indoor rides on each run
BRIDGE_LOOKBACK_DAYS=7

# Set to 1 to process candidate rides but skip the actual Garmin upload
BRIDGE_DRY_RUN=0
